{
  "name": "mosaic",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts/local-verify",
    "design",
    "demo"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck -w @mosaic/web",
    "build": "npm run build -w @mosaic/web",
    "e2e": "npm run build -w @mosaic/web && cd apps/web && node --experimental-strip-types e2e/flows.mjs && node e2e/motion-check.mjs",
    "dev": "npm run dev -w @mosaic/web"
  },
  "type": "module"
}
