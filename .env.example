# Mosaic environment variables.
# Copy to .env.local (git-ignored) for local development. Never commit real values.
# PUBLIC: safe to ship in the client bundle. SECRET: never commit, log, bundle or show on screen.

# --- Firebase web app config (PUBLIC) ---------------------------------------
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- App Check (PUBLIC site key) --------------------------------------------
# Provider: "recaptcha-v3" (no-cost default) or "recaptcha-enterprise".
VITE_APPCHECK_PROVIDER=recaptcha-v3
# reCAPTCHA site key (public). The reCAPTCHA *secret* key goes only into the Firebase console, never here.
VITE_APPCHECK_SITE_KEY=

# --- App Check debug token (SECRET, local development only) ----------------
# Registered in Firebase console > App Check > Apps > (web app) > Manage debug tokens.
# Read only by the dev server. Never set in production builds or CI deploys.
APPCHECK_DEBUG_TOKEN=

# --- Deployment (PUBLIC identifiers) ----------------------------------------
FIREBASE_PROJECT_ID=
# Defaults to the project ID (<id>.web.app) if left empty.
FIREBASE_HOSTING_SITE=
# Used in the README, the video's closing scene and the Devpost text.
PUBLIC_HOSTED_URL=
PUBLIC_REPO_URL=

# --- Demo pipeline only (SECRET) --------------------------------------------
# Used only by demo/ scripts. Never bundled into the web app.
# In the cloud session, this key is held by the network proxy and injected into requests to
# api.elevenlabs.io, so the scripts only need a placeholder here.
ELEVENLABS_API_KEY=
# Chosen by auditioning stock voices on the real script; recorded in demo/ASSETS.md.
ELEVENLABS_VOICE_ID=
